#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Builds the ztMETRO shell (Zerone Laboratories' ztOS, GPL-3.0-only) and its
# own apps inside the debian-13-ztmetro image root. build-all.sh runs it once
# as root in the chroot, with the verified source archives in /tmp/src.
# wlroots 0.20 needs newer Wayland, wayland-protocols, libdrm, xkbcommon
# and pixman than Debian 13 has, so all of them are built into /usr/local
# first; each stays compatible with the system's programs. The
# phone-hardware daemons (modem, sensors, touch keys) are left out: the guest
# has none of that hardware.
set -eu

fail()
{
	echo "ztmetro-build: $*" >&2
	exit 1
}

src=/tmp/src
[ -d "$src" ] || fail "no sources in $src"
cd "$src"

build_deps="build-essential pkg-config meson ninja-build bison libffi-dev
	libexpat1-dev libxml2-dev xkb-data
	libwayland-dev wayland-protocols libxkbcommon-dev libcairo2-dev
	libpango1.0-dev librsvg2-dev libgdk-pixbuf-2.0-dev libdrm-dev libegl-dev
	libgles-dev libgbm-dev libinput-dev libseat-dev libudev-dev hwdata
	libdisplay-info-dev liblcms2-dev libpulse-dev libjson-c-dev libsystemd-dev
	libglib2.0-dev libpolkit-agent-1-dev"
# shellcheck disable=SC2086
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $build_deps

prefix=/usr/local
export PKG_CONFIG_PATH="$prefix/lib/aarch64-linux-gnu/pkgconfig:$prefix/lib/pkgconfig:$prefix/share/pkgconfig"

# meson_build NAME SOURCE OPTION...: builds and installs one release.
meson_build()
{
	name=$1
	source=$2
	shift 2
	meson setup "$name-build" "$source" --prefix="$prefix" \
		--buildtype=release --wrap-mode=nodownload "$@"
	ninja -C "$name-build" install
	ldconfig
}

for archive in wayland-1.*.tar.xz wayland-protocols-*.tar.xz libdrm-*.tar.xz \
	libxkbcommon-*.tar.gz; do
	tar -xf "$archive"
done
meson_build wayland wayland-1.*/ -Ddocumentation=false -Dtests=false
meson_build wayland-protocols wayland-protocols-*/ -Dtests=false
meson_build libdrm libdrm-*/ -Dtests=false -Dvalgrind=disabled \
	-Dintel=disabled -Dcairo-tests=disabled -Dman-pages=disabled
# Every program loads this xkbcommon, so it reads Debian's keyboard layouts.
meson_build xkbcommon libxkbcommon-*/ -Denable-x11=false -Denable-docs=false \
	-Denable-tools=false -Denable-xkbregistry=false -Denable-bash-completion=false \
	-Dxkb-config-root=/usr/share/X11/xkb -Dx-locale-root=/usr/share/X11/locale

tar -xf pixman-*.tar.gz
meson_build pixman pixman-*/ -Dtests=disabled -Ddemos=disabled

tar -xf wlroots-*.tar.gz
meson_build wlroots wlroots-*/ -Dexamples=false -Dxwayland=disabled \
	-Dxcb-errors=disabled -Drenderers=gles2 -Dbackends=drm,libinput \
	-Dsession=enabled -Dlibliftoff=disabled

tar -xf ztos-*.tar.gz
cd ztOS-*/ztmetro
# An iPhone has no Back or Home buttons, though the guest keyboard reports
# those keys: the shell keeps its navigation bar whatever keys it finds.
grep -q 'if (hardware_nav_keys()) {' ztmetro.c ||
	fail "ztmetro.c no longer decides the bar from hardware keys"
sed -i 's/if (hardware_nav_keys()) {/if (false \&\& hardware_nav_keys()) {/' ztmetro.c
# The apps were written on a Galaxy S9: they name its chip and GPU, and read
# its battery and charger. A Linuxed guest names the iPhone it runs on
# (linuxed-info.h) and has the battery and linuxed-mains supplies.
replace()
{
	file=$1
	shift
	for edit in "$@"; do
		grep -qF -- "${edit%%|*}" "$file" || fail "$file no longer has: ${edit%%|*}"
	done
	for edit in "$@"; do
		from=${edit%%|*} to=${edit#*|}
		FROM=$from TO=$to perl -0pi -e 's/\Q$ENV{FROM}\E/$ENV{TO}/g' "$file"
	done
}
cp /tmp/linuxed-info.h settings/linuxed-info.h
cp /tmp/linuxed-info.h devices/linuxed-info.h
replace settings/ztsettings.c \
	'#include <errno.h>|#include <errno.h>
#include "linuxed-info.h"' \
	'"Exynos 9810 (8 cores), %s", app.cpu_gov|"%s, %s", linuxed_cpu(), app.cpu_gov' \
	'"Mali-G72 MP18 (%s), 60 FPS", app.gpu_gov|"%s (%s), 60 FPS", linuxed_gpu(), app.gpu_gov' \
	'"Samsung Galaxy S9, ztOS Mobile"|linuxed_about()' \
	'"Samsung Exynos 9810 (10nm LPP)"|linuxed_cpu()' \
	'"ARM Mali-G72 MP18 (Bifrost)"|linuxed_gpu()' \
	'"Samsung Galaxy S9 (SM-G960N starlte)"|linuxed_host()' \
	'Lumia Cyan/Background_01.jpg|Linuxed/Background_01.png' \
	'Lumia Cyan lock screens/Wallpaper_01.jpg|Linuxed/Lock_01.png'
replace ztmetro.c \
	'Lumia Cyan/Background_01.jpg|Linuxed/Background_01.png' \
	'Lumia Cyan lock screens/Wallpaper_01.jpg|Linuxed/Lock_01.png'
replace devices/ztdevices.c '"Graphics (Mali-G72)"|"Graphics (Apple GPU)"'
for file in core/ztos-hw.h settings/ztsettings.c power/ztpower.c devices/ztdevices.c; do
	sed -i 's#power_supply/max170xx_battery#power_supply/battery#g;
		s#power_supply/max77705-charger#power_supply/linuxed-mains#g' "$file"
done
programs="ztmetro apps/ztapps settings/ztsettings files/ztfiles
	devices/ztdevices power/ztpower sound/ztsound splash/ztos-splash
	sounds/ztos-sounds auth/ztos-polkit-agent"
# shellcheck disable=SC2086
make -j"$(nproc)" $programs

for program in $programs; do
	install -Dm755 "$program" "$prefix/bin/${program##*/}"
done
install -Dm755 ztmetro-session "$prefix/bin/ztmetro-session"
for app in files/ztfiles devices/ztdevices power/ztpower sound/ztsound; do
	name=${app##*/}
	install -Dm644 "$app.desktop" "$prefix/share/applications/$name.desktop"
	[ ! -f "$app.svg" ] ||
		install -Dm644 "$app.svg" "$prefix/share/icons/hicolor/scalable/apps/$name.svg"
done
[ ! -d assets ] || cp -a assets "$prefix/share/ztmetro-assets"

# Keep every package that a built program loads a library from, then drop
# the build tools: the programs live in /usr/local, which dpkg does not see.
# ldd names libraries by /lib paths, which dpkg knows by their /usr/lib ones.
keep=$(for binary in "$prefix"/bin/* "$prefix"/lib/aarch64-linux-gnu/*.so*; do
	[ -f "$binary" ] && ldd "$binary" 2>/dev/null || true
done | awk '/=> \//{print $3}' | xargs -r readlink -f | sort -u |
	grep -v "^$prefix/" | xargs -r dpkg -S 2>/dev/null | cut -d: -f1 | sort -u)
# shellcheck disable=SC2086
[ -z "$keep" ] || apt-mark manual $keep >/dev/null
# shellcheck disable=SC2086
apt-mark auto $build_deps >/dev/null
DEBIAN_FRONTEND=noninteractive apt-get autoremove --purge -y
for binary in "$prefix"/bin/*; do
	missing=$(ldd "$binary" 2>/dev/null | awk '/not found/{print $1}' | tr '\n' ' ')
	[ -z "$missing" ] || fail "$binary lost $missing"
done
cd /
rm -rf "$src"
