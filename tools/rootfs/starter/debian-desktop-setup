#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Desktop policy of the Debian XFCE, Phosh and Plasma Mobile images; the
# argument names the
# session. build-all.sh runs it once as root in the image root after the
# desktop packages are installed. README.md beside this script owns the
# contract.
set -eu

session=$1
fail()
{
	echo "debian-$session setup: $*" >&2
	exit 1
}
case "$session" in xfce|phosh|plasma-mobile) ;; *) fail "unknown session" ;; esac

install -d -m 0755 /etc/udev/rules.d
cat > /etc/udev/rules.d/59-linuxed-input.rules <<'RULES'
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Linuxed Touchscreen", ENV{ID_INPUT}="1", ENV{ID_INPUT_TOUCHSCREEN}="1"
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Linuxed Keyboard", ENV{ID_INPUT}="1", ENV{ID_INPUT_KEYBOARD}="1"
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Darwin UML VNC Keyboard", ENV{ID_INPUT}="1", ENV{ID_INPUT_KEYBOARD}="1"
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Darwin UML VNC Tablet", ENV{ID_INPUT}="1", ENV{ID_INPUT_MOUSE}="1"
RULES
chmod 0644 /etc/udev/rules.d/59-linuxed-input.rules

useradd -m -s /bin/bash user
passwd -d user
# The guest is a single-owner sandbox inside the app, so root takes no
# password: su and sudo reach it from user. sshd keeps its defaults, no root
# password login and no empty passwords, so the shell the app forwards on
# loopback port 2222 opens once user has a password.
passwd -d root
printf '%s\n' 'user ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/user
chmod 0440 /etc/sudoers.d/user
for group in sudo video input audio render; do
	if getent group "$group" >/dev/null; then
		usermod -a -G "$group" user
	fi
done

case "$session" in
xfce)
	install -d -m 0755 /etc/lightdm/lightdm.conf.d
	printf '%s\n' '[Seat:*]' 'autologin-user=user' 'autologin-session=xfce' \
		'user-session=xfce' > /etc/lightdm/lightdm.conf.d/50-linuxed.conf
	[ -f /usr/share/xsessions/xfce.desktop ] ||
		fail "the image has no XFCE session"
	# The compositor keeps each window's contents, so a moved window leaves
	# no trail while the windows it uncovers repaint on the emulated CPU.
	if [ -f /usr/share/xfwm4/defaults ]; then
		sed -i 's/^use_compositing=.*/use_compositing=true/' \
			/usr/share/xfwm4/defaults
	fi
	display_manager=lightdm
	;;
phosh)
	# greetd starts Phosh as user at boot and again after a logout, so the
	# image needs no greeter. Phosh's own development unit would race it.
	[ -x /usr/bin/phosh-session ] || fail "the image has no Phosh session"
	systemctl disable phosh.service 2>/dev/null || true
	rm -f /etc/systemd/system/graphical.target.wants/phosh.service
	install -d -m 0755 /etc/greetd
	cat > /etc/greetd/config.toml <<'CONFIG'
[terminal]
vt = "next"

[default_session]
command = "phosh-session"
user = "user"

[initial_session]
command = "phosh-session"
user = "user"
CONFIG
	# user has no password, so a lock screen could never be unlocked.
	cat > /usr/share/glib-2.0/schemas/80-kellylinux-lock.gschema.override <<'OVERRIDE'
[org.gnome.desktop.screensaver]
lock-enabled=false

[org.gnome.desktop.session]
idle-delay=uint32 0

[org.gnome.desktop.interface]
enable-animations=false
OVERRIDE
	display_manager=greetd
	;;
plasma-mobile)
	[ -f /usr/share/wayland-sessions/plasma-mobile.desktop ] ||
		fail "the image has no Plasma Mobile session"
	install -d -m 0755 /etc/sddm.conf.d
	printf '%s\n' '[Autologin]' 'User=user' 'Session=plasma-mobile' \
		'Relogin=true' > /etc/sddm.conf.d/50-linuxed.conf
	# user has no password, so a lock screen could never be unlocked.
	install -d -m 0755 /etc/xdg
	printf '%s\n' '[Daemon]' 'Autolock=false' 'LockOnResume=false' \
		> /etc/xdg/kscreenlockerrc
	# Every emulated instruction is slow: no animations, no file indexer.
	printf '%s\n' '[KDE]' 'AnimationDurationFactor=0' > /etc/xdg/kdeglobals
	printf '%s\n' '[Basic Settings]' 'Indexing-Enabled=false' \
		> /etc/xdg/baloofilerc
	display_manager=sddm
	;;
esac
systemctl enable "$display_manager.service" ssh.service
ln -sfn "/usr/lib/systemd/system/$display_manager.service" \
	/etc/systemd/system/display-manager.service
systemctl set-default graphical.target

# Every guest instruction is emulated, so background work a phone guest has
# no use for is masked: package refreshes, indexers, modems, Bluetooth,
# printing, network discovery and firmware updates. The journal stays in RAM.
for unit in apt-daily.timer apt-daily-upgrade.timer man-db.timer \
	dpkg-db-backup.timer e2scrub_all.timer fstrim.timer \
	packagekit.service packagekit-offline-update.service \
	ModemManager.service bluetooth.service cups.service \
	cups-browsed.service avahi-daemon.service avahi-daemon.socket \
	fwupd.service fwupd-refresh.timer; do
	ln -sfn /dev/null "/etc/systemd/system/$unit"
done
install -d -m 0755 /etc/systemd/user
for unit in tracker-miner-fs-3.service tracker-extract-3.service \
	localsearch-3.service localsearch-extractor-3.service; do
	ln -sfn /dev/null "/etc/systemd/user/$unit"
done
install -d -m 0755 /etc/systemd/journald.conf.d
printf '%s\n' '[Journal]' 'Storage=volatile' 'RuntimeMaxUse=16M' \
	> /etc/systemd/journald.conf.d/50-kellylinux.conf

# Linuxed's console is ttyS0; its getty logs root in, while the shared
# Debian base's hvc0 getty waits on a device Linuxed lacks.
systemctl disable serial-getty@hvc0.service
install -d -m 0755 /etc/systemd/system/serial-getty@ttyS0.service.d
cat > /etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf <<'UNIT'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin root --noclear - $TERM
UNIT

# gpucheck reports in one line whether Mesa reaches the GPU or draws in
# software, the way the session's compositor opens it.
cat > /usr/local/bin/gpucheck <<'CHECK'
#!/bin/sh
renderer=$(eglinfo -B -p gbm 2>/dev/null |
	sed -n 's/^OpenGL.*renderer: *//p' | head -n 1)
case "$renderer" in
'') echo "no GPU renderer found" ;;
*llvmpipe*|*softpipe*) echo "software rendering: $renderer" ;;
*) echo "GPU accelerated: $renderer" ;;
esac
CHECK
chmod 0755 /usr/local/bin/gpucheck

# fastfetch shows the Apple logo, names the Apple device as the host, and the
# display after the renderer; the rest is fastfetch's default module list.
install -m 0755 /tmp/kellylinux-host /usr/libexec/kellylinux-host
install -d -m 0755 /etc/xdg/fastfetch
cat > /etc/xdg/fastfetch/config.jsonc <<'CONFIG'
{
  "logo": { "source": "macos" },
  "modules": [
    "title", "separator", "os",
    { "type": "command", "key": "Host", "text": "/usr/libexec/kellylinux-host" },
    "kernel", "uptime", "packages", "shell",
    { "type": "display", "key": "Display (KellyRender)" },
    "de", "wm", "wmtheme", "theme", "icons", "font", "cursor", "terminal",
    "terminalfont", "cpu", "gpu", "memory", "swap", "disk", "localip",
    "battery", "poweradapter", "locale", "break", "colors"
  ]
}
CONFIG

# Browsers, when installed, skip JavaScript compilation: code a guest
# compiles at run time is the emulator's slowest path, so V8's and
# SpiderMonkey's interpreters load pages sooner here. Chromium also renders
# on the GPU even where it would distrust the virtual one, scrolls without
# animation, and keeps few renderer processes for the guest's few vCPUs.
install -d -m 0755 /etc/chromium.d /etc/firefox-esr
cat > /etc/chromium.d/linuxed-performance <<'FLAGS'
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --js-flags=--jitless --ignore-gpu-blocklist --enable-gpu-rasterization --disable-smooth-scrolling --renderer-process-limit=2"
FLAGS
cat > /etc/firefox-esr/linuxed-performance.js <<'PREFS'
pref("javascript.options.baselinejit", false);
pref("javascript.options.ion", false);
pref("javascript.options.wasm_baselinejit", false);
pref("javascript.options.wasm_optimizingjit", false);
pref("general.smoothScroll", false);
PREFS

# A wallpaper the build supplies becomes the session's default backdrop. XFCE
# gets it in place of xfdesktop's compiled-in default, so every monitor and
# workspace shows it without per-output keys; Phosh reads GNOME's setting,
# and Plasma's default wallpaper package takes it as its only image.
if [ -f /tmp/wallpaper.png ]; then
	wallpaper=/usr/share/backgrounds/kellylinux.png
	install -D -m 0644 /tmp/wallpaper.png "$wallpaper"
	case "$session" in
	xfce)
		defaults=$(grep -rahoE '/usr/share/(backgrounds|images/desktop-base)/[A-Za-z0-9._/-]+\.(png|jpg|svg)' \
			/usr/bin/xfdesktop* /usr/lib/*/libxfce4* /usr/lib/*/xfce4 \
			2>/dev/null | sort -u)
		[ -n "$defaults" ] || fail "cannot find xfdesktop's default backdrop"
		for default in $defaults; do
			install -d -m 0755 "${default%/*}"
			ln -sf "$wallpaper" "$default"
		done
		;;
	phosh)
		cat > /usr/share/glib-2.0/schemas/90-kellylinux.gschema.override <<OVERRIDE
[org.gnome.desktop.background]
picture-uri='file://$wallpaper'
picture-uri-dark='file://$wallpaper'
picture-options='zoom'
OVERRIDE
		;;
	plasma-mobile)
		images=/usr/share/wallpapers/Next/contents/images
		[ -d "$images" ] || fail "Plasma has no default wallpaper package"
		for directory in "$images" "${images}_dark"; do
			[ -d "$directory" ] || continue
			find "$directory" -mindepth 1 -delete
			ln -s "$wallpaper" "$directory/1179x2556.png"
		done
		;;
	esac
fi
glib-compile-schemas /usr/share/glib-2.0/schemas

# Linuxed mounts the image read-only beneath an overlay from its own /init,
# so the image mounts no root of its own.
printf '%s\n' '# The root is the overlay the per-run /init mounts.' > /etc/fstab
