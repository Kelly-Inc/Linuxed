From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 28 Aug 2026 15:31:43 +0900
Subject: [PATCH] Add file-only GPT core library for iOS

---
 Makefile.linuxed    |  33 +++++++
 diskio-unix.cc      |  29 +++++-
 guid.cc             |   2 +-
 linuxed_gptfdisk.cc | 231 ++++++++++++++++++++++++++++++++++++++++++++
 linuxed_gptfdisk.h  |  57 +++++++++++
 support.h           |   7 +-
 6 files changed, 354 insertions(+), 5 deletions(-)
 create mode 100644 Makefile.linuxed
 create mode 100644 linuxed_gptfdisk.cc
 create mode 100644 linuxed_gptfdisk.h

diff --git a/Makefile.linuxed b/Makefile.linuxed
new file mode 100644
index 0000000000000000000000000000000000000000..fe57e285ce6a5ac7d0eb8eb7d59bc6f3a9c26ded
--- /dev/null
+++ b/Makefile.linuxed
@@ -0,0 +1,33 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+CXX ?= c++
+AR ?= ar
+RANLIB ?= ranlib
+BUILD_DIR ?= build-linuxed
+LIBRARY ?= $(BUILD_DIR)/liblinuxed_gptfdisk.a
+
+CORE_SOURCES = \
+	attributes.cc basicmbr.cc bsd.cc crc32.cc diskio.cc diskio-unix.cc \
+	gpt.cc gptpart.cc guid.cc mbr.cc mbrpart.cc parttypes.cc support.cc \
+	linuxed_gptfdisk.cc
+CORE_OBJECTS = $(CORE_SOURCES:%.cc=$(BUILD_DIR)/%.o)
+
+# The file-only core, its language standard and its hidden symbols are what
+# this library is, so they apply on top of whatever flags the caller passes.
+override CPPFLAGS += -DLINUXED_GPTFDISK_FILE_ONLY=1
+override CXXFLAGS += -fvisibility=hidden -std=c++17
+
+.PHONY: all clean
+
+all: $(LIBRARY)
+
+$(LIBRARY): $(CORE_OBJECTS)
+	$(AR) crs $@ $(CORE_OBJECTS)
+	$(RANLIB) $@
+
+$(BUILD_DIR)/%.o: %.cc
+	@mkdir -p $(BUILD_DIR)
+	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@
+
+clean:
+	rm -rf $(BUILD_DIR)
