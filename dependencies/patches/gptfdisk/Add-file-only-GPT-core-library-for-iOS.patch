diff --git a/linuxed_gptfdisk.cc b/linuxed_gptfdisk.cc
new file mode 100644
index 0000000000000000000000000000000000000000..f8678a0efaff1ca0493358c44ffc1620de8c30ec
--- /dev/null
+++ b/linuxed_gptfdisk.cc
@@ -0,0 +1,231 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "linuxed_gptfdisk.h"
+
+#include <cctype>
+#include <exception>
+#include <iostream>
+#include <mutex>
+#include <sstream>
+#include <string>
+
+#include "gpt.h"
+
+namespace {
+
+std::mutex gptfdiskMutex;
+
+// The core explains a failure only on std::cout and std::cerr. Both streams
+// belong to the whole process, so while a call runs every thread's output to
+// them lands here; a failed call hands what the core wrote to its caller.
+class ScopedOutputCapture {
+public:
+   ScopedOutputCapture() : oldCout(std::cout.rdbuf(output.rdbuf())),
+                           oldCerr(std::cerr.rdbuf(output.rdbuf())) {}
+   ~ScopedOutputCapture() {
+      std::cout.rdbuf(oldCout);
+      std::cerr.rdbuf(oldCerr);
+   }
+
+   std::string Text() const { return output.str(); }
+
+private:
+   std::ostringstream output;
+   std::streambuf *oldCout;
+   std::streambuf *oldCerr;
+};
+
+// GPTData's operator[] is const, so a partition's end is set here.
+class LinuxedGPTData : public GPTData {
+public:
+   void SetPartitionLastLBA(uint32_t index, uint64_t lastLBA) {
+      partitions[index].SetLastLBA(lastLBA);
+   }
+};
+
+void SetError(char *error, size_t errorSize, const char *message) {
+   if ((error == NULL) || (errorSize == 0))
+      return;
+   size_t length = 0;
+   while ((message[length] != '\0') && (length + 1 < errorSize)) {
+      error[length] = message[length];
+      length++;
+   }
+   error[length] = '\0';
+}
+
+// Appends the core's own diagnostics to a failure message, on one line and
+// cut to the caller's buffer.
+void AppendDiagnostics(char *error, size_t errorSize, const std::string &text) {
+   if ((error == NULL) || (errorSize == 0))
+      return;
+   std::string diagnostics;
+   bool space = false;
+   for (const char character : text) {
+      if (std::isspace(static_cast<unsigned char>(character)) ||
+          std::iscntrl(static_cast<unsigned char>(character))) {
+         space = !diagnostics.empty();
+         continue;
+      }
+      if (space)
+         diagnostics += ' ';
+      diagnostics += character;
+      space = false;
+   }
+   if (diagnostics.empty())
+      return;
+   std::string message(error);
+   message += message.empty() ? "" : ": ";
+   message += diagnostics;
+   SetError(error, errorSize, message.c_str());
+}
+
+int Load(const char *path, uint32_t partitionNumber, LinuxedGPTData *gpt,
+         uint32_t *index, char *error, size_t errorSize) {
+   if ((path == NULL) || (path[0] == '\0') || (gpt == NULL) ||
+       (index == NULL) || (partitionNumber == 0)) {
+      SetError(error, errorSize, "invalid GPT fdisk argument");
+      return LINUXED_GPTFDISK_INVALID_ARGUMENT;
+   }
+
+   gpt->BeQuiet(1);
+   if (!gpt->LoadPartitions(path)) {
+      SetError(error, errorSize, "could not read disk image");
+      return LINUXED_GPTFDISK_IO_ERROR;
+   }
+   if (gpt->WhichWasUsed() != use_gpt) {
+      SetError(error, errorSize, "disk image does not contain a usable GPT");
+      return LINUXED_GPTFDISK_INVALID_GPT;
+   }
+
+   *index = partitionNumber - 1;
+   if (!gpt->ValidPartNum(*index) || !gpt->IsUsedPartNum(*index)) {
+      SetError(error, errorSize, "requested GPT partition does not exist");
+      return LINUXED_GPTFDISK_INVALID_PARTITION;
+   }
+   return LINUXED_GPTFDISK_OK;
+}
+
+void FillInfo(LinuxedGPTData &gpt, uint32_t index,
+              linuxed_gptfdisk_partition_info *info) {
+   if (info == NULL)
+      return;
+   info->disk_lbas = gpt.GetSecondHeaderLBA() + 1;
+   info->first_lba = gpt[index].GetFirstLBA();
+   info->last_lba = gpt[index].GetLastLBA();
+   info->backup_header_lba = gpt.GetSecondHeaderLBA();
+   info->block_size = gpt.GetBlockSize();
+}
+
+int ReadPartition(const char *path, uint32_t partitionNumber,
+                  linuxed_gptfdisk_partition_info *info,
+                  char *error, size_t errorSize) {
+   LinuxedGPTData gpt;
+   uint32_t index = 0;
+   const int result = Load(path, partitionNumber, &gpt, &index, error, errorSize);
+   if (result != LINUXED_GPTFDISK_OK)
+      return result;
+   FillInfo(gpt, index, info);
+   SetError(error, errorSize, "");
+   return LINUXED_GPTFDISK_OK;
+}
+
+int GrowPartition(const char *path, uint32_t partitionNumber,
+                  uint64_t trailingFreeBytes,
+                  linuxed_gptfdisk_partition_info *info,
+                  char *error, size_t errorSize) {
+   LinuxedGPTData gpt;
+   uint32_t index = 0;
+   int result = Load(path, partitionNumber, &gpt, &index, error, errorSize);
+   if (result != LINUXED_GPTFDISK_OK)
+      return result;
+
+   const uint32_t blockSize = gpt.GetBlockSize();
+   if ((blockSize == 0) || (trailingFreeBytes < blockSize) ||
+       ((trailingFreeBytes % blockSize) != 0)) {
+      SetError(error, errorSize,
+               "trailing free space must be a positive multiple of the block size");
+      return LINUXED_GPTFDISK_INVALID_ARGUMENT;
+   }
+
+   const uint64_t oldBackupHeader = gpt.GetSecondHeaderLBA();
+   gpt.MoveSecondHeaderToEnd();
+   const uint64_t trailingLBAs = trailingFreeBytes / blockSize;
+   if (gpt.GetSecondHeaderLBA() <= trailingLBAs) {
+      SetError(error, errorSize, "disk image is too small for the requested GPT layout");
+      return LINUXED_GPTFDISK_INVALID_ARGUMENT;
+   }
+   const uint64_t desiredLastLBA = gpt.GetSecondHeaderLBA() - trailingLBAs;
+   const uint64_t currentLastLBA = gpt[index].GetLastLBA();
+   if (desiredLastLBA < currentLastLBA) {
+      SetError(error, errorSize, "GPT partition resizing would shrink existing data");
+      return LINUXED_GPTFDISK_WOULD_SHRINK;
+   }
+   if (desiredLastLBA > gpt.GetLastUsableLBA()) {
+      SetError(error, errorSize, "requested partition end exceeds usable GPT space");
+      return LINUXED_GPTFDISK_INVALID_ARGUMENT;
+   }
+
+   for (uint32_t other = 0; other < gpt.GetNumParts(); other++) {
+      if ((other == index) || !gpt.IsUsedPartNum(other))
+         continue;
+      if ((gpt[other].GetFirstLBA() <= desiredLastLBA) &&
+          (gpt[other].GetLastLBA() >= gpt[index].GetFirstLBA())) {
+         SetError(error, errorSize, "growing partition would overlap another GPT partition");
+         return LINUXED_GPTFDISK_OVERLAP;
+      }
+   }
+
+   // Load proved the partition exists and is used, and nothing since has
+   // touched the partition array.
+   if (desiredLastLBA != currentLastLBA)
+      gpt.SetPartitionLastLBA(index, desiredLastLBA);
+   if ((desiredLastLBA != currentLastLBA) ||
+       (oldBackupHeader != gpt.GetSecondHeaderLBA())) {
+      if (!gpt.SaveGPTData(1)) {
+         SetError(error, errorSize, "could not write resized GPT");
+         return LINUXED_GPTFDISK_WRITE_ERROR;
+      }
+   }
+
+   return ReadPartition(path, partitionNumber, info, error, errorSize);
+}
+
+} // namespace
+
+int linuxed_gptfdisk_read_partition(
+   const char *path, uint32_t partition_number,
+   linuxed_gptfdisk_partition_info *info, char *error, size_t error_size) {
+   std::lock_guard<std::mutex> lock(gptfdiskMutex);
+   ScopedOutputCapture capture;
+   int result = LINUXED_GPTFDISK_INTERNAL_ERROR;
+   try {
+      result = ReadPartition(path, partition_number, info, error, error_size);
+   } catch (const std::exception &exception) {
+      SetError(error, error_size, exception.what());
+   } catch (...) {
+      SetError(error, error_size, "unexpected GPT fdisk failure");
+   }
+   if (result != LINUXED_GPTFDISK_OK)
+      AppendDiagnostics(error, error_size, capture.Text());
+   return result;
+}
+
+int linuxed_gptfdisk_grow_partition_to_fill(
+   const char *path, uint32_t partition_number, uint64_t trailing_free_bytes,
+   linuxed_gptfdisk_partition_info *info, char *error, size_t error_size) {
+   std::lock_guard<std::mutex> lock(gptfdiskMutex);
+   ScopedOutputCapture capture;
+   int result = LINUXED_GPTFDISK_INTERNAL_ERROR;
+   try {
+      result = GrowPartition(path, partition_number, trailing_free_bytes, info,
+                             error, error_size);
+   } catch (const std::exception &exception) {
+      SetError(error, error_size, exception.what());
+   } catch (...) {
+      SetError(error, error_size, "unexpected GPT fdisk failure");
+   }
+   if (result != LINUXED_GPTFDISK_OK)
+      AppendDiagnostics(error, error_size, capture.Text());
+   return result;
+}
diff --git a/linuxed_gptfdisk.h b/linuxed_gptfdisk.h
new file mode 100644
index 0000000000000000000000000000000000000000..01991524da3005e507488772d517123258cb7c8b
--- /dev/null
+++ b/linuxed_gptfdisk.h
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#ifndef LINUXED_GPTFDISK_H
+#define LINUXED_GPTFDISK_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {
+   LINUXED_GPTFDISK_OK = 0,
+   LINUXED_GPTFDISK_INVALID_ARGUMENT = 1,
+   LINUXED_GPTFDISK_IO_ERROR = 2,
+   LINUXED_GPTFDISK_INVALID_GPT = 3,
+   LINUXED_GPTFDISK_INVALID_PARTITION = 4,
+   LINUXED_GPTFDISK_WOULD_SHRINK = 5,
+   LINUXED_GPTFDISK_OVERLAP = 6,
+   LINUXED_GPTFDISK_WRITE_ERROR = 7,
+   LINUXED_GPTFDISK_INTERNAL_ERROR = 8,
+};
+
+typedef struct linuxed_gptfdisk_partition_info {
+   uint64_t disk_lbas;
+   uint64_t first_lba;
+   uint64_t last_lba;
+   uint64_t backup_header_lba;
+   uint32_t block_size;
+} linuxed_gptfdisk_partition_info;
+
+/*
+ * Calls are serialized. While one runs, std::cout and std::cerr of the whole
+ * process are redirected, because the GPT fdisk core reports its reasons only
+ * there; a failed call appends that output to the message in error.
+ */
+int linuxed_gptfdisk_read_partition(
+   const char *path,
+   uint32_t partition_number,
+   linuxed_gptfdisk_partition_info *info,
+   char *error,
+   size_t error_size);
+
+int linuxed_gptfdisk_grow_partition_to_fill(
+   const char *path,
+   uint32_t partition_number,
+   uint64_t trailing_free_bytes,
+   linuxed_gptfdisk_partition_info *info,
+   char *error,
+   size_t error_size);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
